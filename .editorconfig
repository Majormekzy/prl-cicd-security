# See http://editorconfig.org

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

# default
indent_size = 4
indent_style = space

[*.yaml]
indent_style = space
indent_size = 2

[*.yml]
indent_style = space
indent_size = 2

[*.tf]
indent_style = space
indent_size = 2

[*.hcl]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

# Makefiles are broken without using actual tabs for indentation.
[Makefile]
indent_style = tab
indent_size = 4
